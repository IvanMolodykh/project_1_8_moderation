# Скопируйте в .env, только если нужно поменять порты или пароль.
# Без .env стенд стартует с значениями по умолчанию.

# База, пользователь и пароль, которые создаются внутри контейнера при первом запуске.
POSTGRES_DB=moderationdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Порт PostgreSQL на хосте. Меняйте, если 5432 уже занят.
POSTGRES_PORT=5432

# Порт API и Swagger на хосте: http://localhost:5009/swagger
API_PORT=5009

# Порт веб-интерфейса базы (Adminer):
# http://localhost:8081/?pgsql=&username=postgres&db=moderationdb
ADMINER_PORT=8081
